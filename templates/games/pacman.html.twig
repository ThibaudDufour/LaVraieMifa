{% extends 'base.html.twig' %}

{% block title %}Pac-Man{% endblock %}

{% block stylesheets %}
    <link href="/css/pacman.css" rel="stylesheet" type="text/css">
{% endblock %}

{% block body %}
    <div class="grille">
        <div class="instruction">
            <p>
                <strong class="important">Comment jouer :</strong> Appuyez sur entrée, puis utilisez les <strong>flèches directionnelles</strong> pour déplacer Pac-Man<br/>
            </p>
        </div>
        <div class="tableau-score scale-up-hor-right">
            {% if app.user %}
                <p class="ScorePerso">Votre meilleur score est de <b>{{ best_score_perso }}</b></p>
            {% endif %}
            <h3 style="text-align:center;">Top 10 des joueurs</h3>
            <table id="classement" class="table table-striped table-hover table-bordered align-middle text-center" style="margin:auto;">
                <thead class="table-dark">
                    <tr>
                        <th>Place</th>
                        <th>Joueurs</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                {% set compteur = 1 %}
                {% set compareScore = 0 %}
                {% set place = 1 %}
                {% for user in orderedUsers %}
                    {% if compteur <= 10 %}
                        {% if compareScore == user.scorePacMan %}
                            <tr id="place_{{ place }}">
                                <td>{{ place }}</td>
                        {% else %} 
                            <tr id="place_{{ compteur }}">
                                <td>{{ compteur }}</td>
                            {% set place = compteur %}
                        {% endif %} 
                                <td>{{ user.firstname }} {{ user.name }}</td>
                                <td>{{ user.scorePacMan }}</td>
                            </tr>
                        {% set compteur = compteur + 1 %}
                        {% set compareScore = user.scorePacMan %}
                    {% endif %}  
                {% endfor %}
            </table>
        </div>
        <div class="game">
            <div id="main"></div>
            {% if app.user %}
                <p class="ScorePerso"> Tu es connecté(e) ! Ton meilleur score sera enregistré 😊</p>
            {% else %}
                <p class="ScorePerso"> Connectez-vous pour connaître votre meilleur score et pour l'enregistrer 😁<p>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="/js/games/pacman/AStar.js"></script>
  
    <script type="text/javascript" src="/js/games/pacman/Keyboard.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Game.js"></script>
    <script type="text/javascript" src="/js/games/pacman/StartupScene.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PlayScene.js"></script>
    <script type="text/javascript" src="/js/games/pacman/ReadyMessage.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Pacman.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Wall.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Rect.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Pellet.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Gate.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Ghost.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Sprite.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Util.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PowerPellet.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Position.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PointsMessage.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PressEnterText.js"></script>
    <script type="text/javascript" src="/js/games/pacman/BlinkTimer.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PacmanPlaySceneStrategy.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PacmanStartupSceneStrategy.js"></script>
    <script type="text/javascript" src="/js/games/pacman/EventManager.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PacmanDiesPause.js"></script>
    <script type="text/javascript" src="/js/games/pacman/PacmanDiesStrategy.js"></script>
    <script type="text/javascript" src="/js/games/pacman/Cherry.js"></script>
    
    <script type="text/javascript" src="/js/games/pacman/Stats.js"></script>
    
    <script type="text/javascript" src="/js/games/pacman/FPSCounter.js"></script>
    <script type="text/javascript" src="/js/games/pacman/GameRunner.js"></script>
    <script type="text/javascript" src="/js/games/pacman/ImageManager.js"></script>
    <script type="text/javascript" src="/js/games/pacman/SoundManager.js"></script>

    <script type='text/javascript' src='/js/confetti.browser.min.js'></script>

    <script type="text/javascript">
        $(document).ready(function(){
            var theme = sessionStorage.getItem('theme');
            if (theme == 'dark') {
                $("#dark-game").addClass('text-dark');
                $("#classement").addClass('table-dark');
            } else {
                $("#dark-game").removeClass('text-dark');
                $("#classement").removeClass('table-dark');
            }

            var gameRunner = new GameRunner();
            gameRunner.run();

            setInterval(displayConfetti, 1000);

            function displayConfetti() {
                if (sessionStorage.getItem("game")) {
                    var duration = 5 * 1000;
                    var animationEnd = Date.now() + duration;
                    var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

                    function randomInRange(min, max) {
                        return Math.random() * (max - min) + min;
                    }

                    var interval = setInterval(function() {
                        var timeLeft = animationEnd - Date.now();

                        if (timeLeft <= 0) {
                            return clearInterval(interval);
                        }

                        var particleCount = 50 * (timeLeft / duration);
                        // since particles fall down, start a bit higher than random
                        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
                    }, 250);
                    sessionStorage.removeItem('game');
                }
            }
        });
    </script>
{% endblock %}
