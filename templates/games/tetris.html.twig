{% extends 'base.html.twig' %}

{% block title %}Tetris{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="/css/tetris.css">
{% endblock %}

{% block body %}
  <div class="grille">
    <div class="instruction scale-up-hor-left">
      <h3>Comment jouer ?</h3>
      <div>
        <p><b>Q</b> ou <i class="fa fa-arrow-left"></i> : Déplace sur la gauche</p>
        <p><b>D</b> ou <i class="fa fa-arrow-right"></i> : Déplace sur la droite</p>
        <p><b>Z</b> ou <i class="fa fa-arrow-up"></i> : Rotation vers la droite</p>
        <p><b>S</b> ou <i class="fa fa-arrow-down"></i> : Descend la pièce</p>
      </div>
    </div>
    <div class="jeu scale-up-hor-center">
      <canvas id="canvas1">Désolé mais ton navigateur c'est genre une antiquité. Il faut au moins HTML5. Utilise Chrome ou Firefox.</canvas>
      {% if app.user %}
          <p class="ScorePerso"> Tu es connecté(e) ! Ton meilleur score sera enregistré 😊</p>
      {% else %}
          <p class="ScorePerso"> Connectez-vous pour connaître votre meilleur score et pour l'enregistrer 😁<p>
      {% endif %}
    </div>
    <div class="tableau-score scale-up-hor-right">
        {% if app.user %}
            <p class="ScorePerso">Votre meilleur score est de <b>{{ best_score_perso }}</b></p>
        {% endif %}
        <h3 style="text-align:center;">Top 10 des joueurs</h3>
        <table id="classement" class="table table-striped table-hover table-bordered align-middle text-center" style="margin:auto;">
          <thead class="table-dark">
              <tr>
                  <th>Place</th>
                  <th>Joueurs</th>
                  <th>Score</th>
              </tr>
          </thead>
          <tbody>
            {% set compteur = 1 %}
            {% set compareScore = 0 %}
            {% set place = 1 %}
            {% for user in orderedUsers %}
              {% if compteur <= 10 %}
                  {% if compareScore == user.scoreTetris %}
                    <tr id="place_{{ place }}">
                      <td>{{ place }}</td>
                  {% else %} 
                    <tr id="place_{{ compteur }}">
                      <td>{{ compteur }}</td>
                    {% set place = compteur %}
                  {% endif %} 
                      <td>{{ user.firstname }} {{ user.name }}</td>
                      <td>{{ user.scoreTetris }}</td>
                    </tr>
                {% set compteur = compteur + 1 %}
                {% set compareScore = user.scoreTetris %}
              {% endif %}  
            {% endfor %}
        </table>
    </div>
  </div>
  <div class="taille-ecran">
    <h2>Votre écran est trop petit pour jouer à tetris</h2>
    <h5>Utilisez un ordinateur ou un écran plus grand ! <br><a href="{{ path('home') }}">Cliquez ici</a> pour retrourner à l'accueil</h5>
  </div>
{% endblock %}

{% block javascripts %}
  <script type="text/javascript" src="/js/games/tetris.js"></script>
  <script type="text/javascript">
        $(document).ready(function(){
            var theme = sessionStorage.getItem('theme');
            if (theme == 'dark') {
                $("#classement").addClass('table-dark');
            } else {
                $("#classement").removeClass('table-dark');
            }

            function disableScroll(e){
                if (e.keyCode) {
                    /^(32|33|34|35|36|38|40)$/.test(e.keyCode) && e.preventDefault();
                } else {
                    e.preventDefault();
                }
            }

            addEventListener("mousewheel", disableScroll, false);
            addEventListener("DOMMouseScroll", disableScroll, false);
            addEventListener("keydown", disableScroll, false);
        });
    </script>
{% endblock %}
