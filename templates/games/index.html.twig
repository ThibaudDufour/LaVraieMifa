{% block javascripts %}
    <script type="text/javascript">
        $(document).ready(function(){
            $.ajax({
                url : "{{ path('scoreSnake', {'newScore' : 0}) }}",
                type : 'GET',
                dataType : 'json',
                beforeSend: function(){
                    // Code à jouer avant d'éxécuter la requête
                    $("#scoreSnake").html("Chargement du meilleur score <div class='spinner-border spinner-border-sm text-primary' role='status'><span class='visually-hidden'></span></div>");
                }
            })
            .done(function (output) {
                // Code à jouer en cas d'éxécution sans erreur du script du PHP
                $("#scoreSnake").html("🏆 <b>" + output.best_player + "</b> 🏆 est le meilleur joueur avec un score de <b>" + output.best_score + "</b> ! <br>Essayez de le battre 😈😏");
            })
            .fail(function (error) {
                // Code à jouer en cas d'éxécution en erreur du script du PHP ou de ressource introuvable
                $("#scoreSnake").html("Une erreur est survenu ! Nous n'avons pas pu récupérer le meilleur joueur");
