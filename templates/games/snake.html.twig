{% extends "base.html.twig" %}

{% block title %}Snake{% endblock %}

{% block body %}
    <style type="text/css">
        body {
            text-align:center;
            overflow-y: hidden;
            }
        
        .textemulticolore {
            background-image: linear-gradient(to left, violet, indigo, blue, green, yellow, orange, red);  
            -webkit-background-clip: text;
            -webkit-background-clip: text;
            -moz-background-clip: text; 
            background-clip: text;
            color: transparent;
            margin : auto;
        }
        .btn {
            margin : 10px;
        }

        .button-commencer{
            display: none !important;
        }

        .grille{
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-column-gap: 40px;
            margin: auto;
        }

        canvas { 
            margin-top : 20px;
            border:5px solid #4A4747;
            grid-column: 2;
            grid-row: 1;
        }

        .instruction{
            grid-column: 1;
            margin: auto;
            border: 3px outset #1C6EA4;
            border-radius: 20px;
            padding: 10px;
        }

        .tableau-score{
            grid-column: 3;
            margin: auto;
        }

        #place_1 td{
            background-color: gold !important;
            --bs-table-striped-bg: gold  !important;
            color : #000;
        }

        #place_2 td{
            background-color: silver !important;
            --bs-table-striped-bg: silver  !important;
            color : #000;
        }

        #place_3 td{
            background-color: #ad8a56 !important;
            --bs-table-striped-bg: #ad8a56  !important;
            color : #000;
        }

        .dark .textemulticolore {
            background-image: linear-gradient(to left, #761ed4, #3c2cc9, #297ac2, #08783b, #cfc127, #cf6d27, #cf3227);  
            -webkit-background-clip: text;
            -webkit-background-clip: text;
            -moz-background-clip: text; 
            background-clip: text;
            color: transparent;
        }
        .dark canvas {
            border:5px solid #385a8a;
            background : #454545;
        }

        .taille-ecran{
            display: none;
        }

        @media screen and (max-width: 600px) {
            canvas, .instruction, .tableau-score, #ScorePerso, .grille{
                display: none;
            }

            .taille-ecran{
                display: block;
            }
        }
    </style>
    <script type="text/javascript">
        var score = 0;
        var isBestScore = true;
        function compareScores() {
            $.ajax({
            url : '/games/snake/score/current/' + score,
            type : 'GET',
            dataType : 'json',
            success : function(){
                $("#BestScore").load(window.location.href + " #BestScore");
                $("#ScorePerso").load(window.location.href + " #ScorePerso");
                if(isBestScore && score > output.old_best_score_perso){
                    sessionStorage.setItem('game', 'confetti');
                    isBestScore = false;
                }
            }})
        }
        var counter = 4;
        var intervalId = null;
        function finish() {
            clearInterval(intervalId);
            document.getElementById("commencer").innerHTML = counter + " secondes restantes";
            play_game();	
        }
        function bip() {
            counter--;
            if(counter == 0) finish();
            else {	
                document.getElementById("commencer").innerHTML = counter + " secondes restantes";
            }	
        }
        function start(){
            document.getElementById("playArea").focus();
            intervalId = setInterval(bip, 1000);
        }
        function play_game()
        {
           $("#commencer").prop('disabled', true);
           var level = 90; // Game level, by decreasing will speed up
           var rect_w = 35; // Width
           var rect_h = 25; // Height
           var inc_score = 50; // Score
           var snake_color; // Snake Color
           if (sessionStorage.getItem('theme') == 'dark') {
               snake_color = "#0cbeeb";
           } else {
               snake_color = "#0520A5";
           }
           var ctx; // Canvas attributes
           var tn = []; // temp directions storage
           var x_dir = [-1, 0, 1, 0]; // position adjusments
           var y_dir = [0, -1, 0, 1]; // position adjusments
           var queue = [];
           var frog = 1; // defalut food
           var map = [];
           var MR = Math.random;
           var X = 5 + (MR() * (rect_w - 10))|0; // Calculate positions
           var Y = 5 + (MR() * (rect_h - 10))|0; // Calculate positions
           var direction = MR() * 3 | 0;
           var interval = 0;
            //le score calculé en fonction du temps.
           var sum = 0, easy = 0;
           var i, dir;
           var test_score = 0; // => le vrai score classique 1-2-3-4 .....
           // getting play area 
           var c = document.getElementById('playArea');
           ctx = c.getContext('2d');
           
           // Map positions
           for (i = 0; i < rect_w; i++)
           {
               map[i] = [];
           }
           // random placement of snake food
           
           function random_snake()
           {
               var x, y;
               do
               {
                   x = MR() * rect_w|0;
                   y = MR() * rect_h|0;
               }
               while (map[x][y]);

               map[x][y] = 1;
               ctx.fillStyle = snake_color;
               ctx.strokeRect(x * 10+1, y * 10+1, 8, 8); // food 
           }
           // Default somewhere placement
           random_snake();
           function set_game_speed()
           {
               if (easy)
               {
                   X = (X+rect_w)%rect_w;
                   Y = (Y+rect_h)%rect_h;
               }
               --inc_score;
               if (tn.length)
               {
                   dir = tn.pop();
                   if ((dir % 2) !== (direction % 2))
                   {
                       direction = dir;
                   }
               }
               if ((easy || (0 <= X && 0 <= Y && X < rect_w && Y < rect_h)) && 2 !== map[X][Y])
               {
                   if (1 === map[X][Y])
                   {
                       //score+= Math.max(5, inc_score);
                       //inc_score = 50; 
                      
                       score ++;
                        compareScores()
                      
                       var affich_score= document.getElementById("show");
                       affich_score.innerHTML = "<u>Ton score : </u> <b>"+score+"</b>"
                       random_snake();
                       frog++;
                   }
                   ctx.fillRect(X * 10, Y * 10, 9, 9);
                   map[X][Y] = 2;
                   queue.unshift([X, Y]);
                   X+= x_dir[direction];
                   Y+= y_dir[direction];
                   if (frog < queue.length)
                   {
                       dir = queue.pop()
                       map[dir[0]][dir[1]] = 0;
                       ctx.clearRect(dir[0] * 10, dir[1] * 10, 10, 10);
                   }
               }
               else if (!tn.length)
               {
                   var theme = sessionStorage.getItem('theme');
                   var w1btn;
                   var w2btn;
                   var lostbtn;
                       if (theme == 'dark') {
                           w1btn = 'btn-outline-info';
                           w2btn = 'btn-outline-light';
                           lostbtn = 'btn-outline-light';
                       } else {
                           w1btn = 'btn-success';
                           w2btn = 'btn-secondary';
                           lostbtn = 'btn-secondary';
                       }      
               var show_score = document.getElementById("show");
               if ({{best_score_perso}} != -1 && score > {{best_score_perso}}) {
                   show_score.innerHTML = "<p> Félicitations, tu as battu ton record personnel ! 🎉🎉 <br /> <u>Ton score : </u> <b>"+score+"</b><br><br><input type='button' id='lostBtn' class='btn " + lostbtn + "' value='Jouer encore' onclick='window.location.reload();' /></p>";
               } else {
                   show_score.innerHTML = "<p>Tu as perdu &#128549; <br /> <u>Ton score : </u> <b>"+score+"</b><br><br> Tu veux réessayer ?<br><br><input type='button' id='lostBtn' class='btn " + lostbtn + "' value='Jouer encore' onclick='window.location.reload();' /></p>";
               }
               document.getElementById("playArea").style.display = 'none';
               window.clearInterval(interval);       
               }
           }
            interval = window.setInterval(set_game_speed, level);
            document.onkeydown = function(e) 
           {
               var code = e.keyCode - 37;
               if (0 <= code && code < 4 && code !== tn[0])
               {
                   tn.unshift(code);
               }
               else if (-5 == code)
               {
               if (interval)
               {
                   window.clearInterval(interval);
                   interval = 0;
               }
               else
               {
                   interval = window.setInterval(set_game_speed, 60);
               }
               }
               else
               {
                   dir = sum + code;
                   if (dir == 44||dir==94||dir==126||dir==171) 
                   {
                       sum+= code
                   } else if (dir === 218) easy = 1;
               }
           }
        }
    </script>
    <body>
        <h1 class="textemulticolore">Le Jeu du Serpent !</h1>
        <p id="BestScore"> 🏆 Le meilleur score est actuellement {{best_score}}, il est détenu par {{best_player}} 🏆 </p>
        {% if app.user %}
            <p id="ScorePerso"> Ton meilleur score : {{best_score_perso}} </p>
        {% else %}
            <p id="ScorePerso"> Connectez-vous pour connaître votre meilleur score <p>
        {% endif %}
        <div class="grille">
            <div class="instruction">
                <h3>Comment jouer ?</h3>
                <p>Utilise les fléches directionnelles pour déplacer le serpent</p>
            </div>
            <div class="jeu">
                <button id="commencer" class="btn btn-success" onclick="start()">Cliquez ici pour commencer !</button>
                <div id="show"></div>
                <canvas id="playArea" width="350" height="250" tabindex="1">Désolé mais ton navigateur c'est genre une antiquité. Il faut au moins HTML5. Utilise Chrome ou Firefox.</canvas>
            </div>
            <div class="tableau-score">
                <h3 style="text-align:center;">Top 10 des joueurs</h3>
                <table id="classement" class="table table-striped table-hover table-bordered align-middle text-center" style="margin:auto;">
                    <thead class="table-dark">
                        <tr>
                            <th>Place</th>
                            <th>Joueurs</th>
                            <th>Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set compteur = 1 %}
                        {% set compareScore = 0 %}
                        {% set place = 1 %}
                        {% for user in orderedUsers %}
                            {% if compteur <= 10 %}
                                {% if compareScore == user.scoreSnake %}
                                    <tr id="place_{{ place }}">
                                        <td>{{ place }}</td>
                                {% else %} 
                                    <tr id="place_{{ compteur }}">
                                        <td>{{ compteur }}</td>
                                    {% set place = compteur %}
                                {% endif %} 
                                <td>{{ user.firstname }} {{ user.name }}</td>
                                <td>{{ user.scoreSnake }}</td>
                            </tr>
                        {% set compteur = compteur + 1 %}
                        {% set compareScore = user.scoreSnake %}
                        {% endif %}  
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="taille-ecran">
            <h2>Votre écran est trop petit pour jouer à tetris</h2>
            <h5>Utilisez un ordinateur ou un écran plus grand ! <br> <a href="{{ path('home') }}">Cliquez ici</a> pour retrourner à l'accueil</h5>
        </div>
    </body>
{% endblock %}

{% block javascripts %}
    <script type='text/javascript' src='/js/confetti.browser.min.js'></script>
    <script type="text/javascript">
        $(document).ready(function(){
            var theme = sessionStorage.getItem('theme');
                if (theme == 'dark') {
                    $("#classement").addClass('table-dark');
                } else {
                    $("#classement").removeClass('table-dark');
                }

            function disableScroll(e){
                if (e.keyCode) {
                    /^(32|33|34|35|36|38|40)$/.test(e.keyCode) && e.preventDefault();
                } else {
                    e.preventDefault();
                }
            }

            addEventListener("mousewheel", disableScroll, false);
            addEventListener("DOMMouseScroll", disableScroll, false);
            addEventListener("keydown", disableScroll, false);

            setInterval(displayConfetti, 1000);

            function displayConfetti() {
                if (sessionStorage.getItem("game")) {
                    var duration = 5 * 1000;
                    var animationEnd = Date.now() + duration;
                    var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

                    function randomInRange(min, max) {
                        return Math.random() * (max - min) + min;
                    }

                    var interval = setInterval(function() {
                        var timeLeft = animationEnd - Date.now();

                        if (timeLeft <= 0) {
                            return clearInterval(interval);
                        }

                        var particleCount = 50 * (timeLeft / duration);
                        // since particles fall down, start a bit higher than random
                        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
                    }, 250);
                    sessionStorage.removeItem('game');
                }
            }
        });
    </script>
{% endblock %}

