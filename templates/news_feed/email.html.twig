{% extends "base_email.html.twig" %}
{% block emailBody %}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td><p>Bonjour {{firstname}} {{name|upper}} 😇,</p></td>
        </tr>
        <tr>
            <td>
                <p>Vous avez manqué <b>{{ compteur }} poste(s)</b> que les utilisateurs ont ajouté :</p>
                <ul>
                    {% for user in userPoste %}
                        <li>{{user.firstname}} {{user.name|upper}}</li>
                    {% endfor %}
                </ul>
                <p><a href="https://lavraiemifa.fr/news-feed/" target="_blank">Cliquez-ici</a> pour les consulter 😉</p>
            </td>
        </tr>
        <tr>&nbsp;</tr>
        <tr>
            <td>
                <p>Merci, l'équipe La Vraie Mifa.</p>
            </td>
        </tr>
    </table>
{% endblock %}