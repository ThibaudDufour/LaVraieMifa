{% extends 'base.html.twig' %}

{% block title %}News Feed{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/newsfeed.css">
{% endblock %}

{% block body %}
    <div class="grille">
        <div class="cell-1 text-center">
            <h1>News Feed</h1>
            <p>Pas d'inquiétude ! Les liens peuvent mettre un certains temps avant d'apparaître</p>
            <p>Cliquez sur la loupe pour avoir plus de détail sur le poste 😄</p>
        </div>
        {% if app.user %}
            <!-- Vertically centered scrollable modal -->
            <div class="modal fade" id="ajoutModal" tabindex="-1" aria-labelledby="ajoutModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="ajoutModalLabel">Partager un lien</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="">
                                {{ form_start(formNewsFeed,  {'attr': {'id': 'form'}}) }}
                                    <div>
                                        <span class="float-end counter" id="counter">255</span>
                                        {{ form_row(formNewsFeed.contentMessage)}}
                                    </div>
                                    <div class="d-flex justify-content-center form-flex">
                                        <div>
                                            {{ form_row(formNewsFeed.lien)}}
                                        </div>
                                        <div>
                                            {{ form_row(formNewsFeed.typeSocialMedia)}}
                                        </div>
                                    </div>
                                    <div class='taskBtn'>
                                        <button id='submitTaskBtn' class='button'>Partager</button>
                                    </div>
                                {{ form_end(formNewsFeed)}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
            <div class="cell-2">
                <!-- Button trigger modal -->
                <span class="button-add" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-placement="bottom" data-bs-content="Partager un lien">
                    <button type="button" class="btnDelTdl pulsate-bck logo" data-bs-toggle="modal" data-bs-target="#ajoutModal"><i class="fas fa-plus-circle"></i></button>
                </span>
            </div>
        {% endif %}
    </div>
    <hr/>
    {{ include ('news_feed/lien.html.twig') }}
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        $(document).ready(function(){
            const input = document.getElementById('news_feed_form_contentMessage');
            const counter = document.getElementById('counter');
            const maxLength = input.getAttribute('maxlength');

            input.addEventListener('input', event => {
                const valueLength = event.target.value.length;
                const leftCharLength = maxLength - valueLength;

                if (leftCharLength < 0) return;
                    counter.innerText = leftCharLength;
            });

            {% if app.session.remove('missingChamps') %}
                Toastify({
                    text: 'Merci de remplir tous les champs',
                    duration: 3000,
                    close: true,
                    //gravity: "top", // `top` or `bottom`
                    //position: "center", // `left`, `center` or `right`
                    offset: {
                        x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                        y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                    },
                    backgroundColor: 'red', // linear-gradient(to right, #00b09b, #96c93d)
                    stopOnFocus: true, // Prevents dismissing of toast on hover
                    onClick: function(){} // Callback after click
                }).showToast();
            {% endif %}

            {% if app.session.remove('addURL') %}
                Toastify({
                    text: 'Lien ajouté dans la news feed !',
                    duration: 3000,
                    close: true,
                    //gravity: "top", // `top` or `bottom`
                    //position: "center", // `left`, `center` or `right`
                    offset: {
                        x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                        y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                    },
                    backgroundColor: 'green', // linear-gradient(to right, #00b09b, #96c93d)
                    stopOnFocus: true, // Prevents dismissing of toast on hover
                    onClick: function(){} // Callback after click
                }).showToast();
            {% endif %}

            {% if app.session.remove('errorAddURL') %}
                Toastify({
                    text: 'Impossible de partager votre lien',
                    duration: 3000,
                    close: true,
                    //gravity: "top", // `top` or `bottom`
                    //position: "center", // `left`, `center` or `right`
                    offset: {
                        x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                        y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                    },
                    backgroundColor: 'red', // linear-gradient(to right, #00b09b, #96c93d)
                    stopOnFocus: true, // Prevents dismissing of toast on hover
                    onClick: function(){} // Callback after click
                }).showToast();
            {% endif %}
        });

        function copyClipboard(path) {
            /* Copy the text inside the text field */
            navigator.clipboard.writeText(path);
            
            /* Alert the copied text */
            Toastify({
                text: 'Lien copié !​',
                duration: 3000,
                close: true,
                //gravity: "top", // `top` or `bottom`
                //position: "center", // `left`, `center` or `right`
                offset: {
                    x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                    y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                },
                backgroundColor: 'green', // linear-gradient(to right, #00b09b, #96c93d)
                stopOnFocus: true, // Prevents dismissing of toast on hover
                onClick: function(){} // Callback after click
            }).showToast();
        }

        function view(shareLink)
        {
            $.redirect("https://lavraiemifa.fr/news-feed/view/" + shareLink);
        }

        function onClickBtnLike(event){
            event.preventDefault(); // Ne va pas sur le lien

            const url = this.href
            const spanCount = this.querySelector('span.js-likes')
            const icon = this.querySelector('i')

            $.ajax({
                url : this.href,
                type : 'POST',
                dataType : 'json',
                beforeSend: function(){
                    // Code à jouer avant d'éxécuter la requête
                }
            })
            .done(function (output) {
                spanCount.textContent = output.likes
                if(icon.classList.contains('fas'))
                    icon.classList.replace('fas', 'far')
                else
                    icon.classList.replace('far', 'fas')
            })
            .fail(function (error) {
                if(error.status === 403)
                    Toastify({
                        text: 'Connectez-vous pour liker ce poste !',
                        duration: 3000,
                        close: true,
                        //gravity: "top", // `top` or `bottom`
                        //position: "center", // `left`, `center` or `right`
                        offset: {
                            x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                            y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                        },
                        backgroundColor: 'orange', // linear-gradient(to right, #00b09b, #96c93d)
                        stopOnFocus: true, // Prevents dismissing of toast on hover
                        onClick: function(){} // Callback after click
                    }).showToast();
                else
                    Toastify({
                        text: 'Impossible de liker ce post pour le moment',
                        duration: 3000,
                        close: true,
                        //gravity: "top", // `top` or `bottom`
                        //position: "center", // `left`, `center` or `right`
                        offset: {
                            x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                            y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                        },
                        backgroundColor: 'red', // linear-gradient(to right, #00b09b, #96c93d)
                        stopOnFocus: true, // Prevents dismissing of toast on hover
                        onClick: function(){} // Callback after click
                    }).showToast();
            })
        }

        document.querySelectorAll('a.js-like').forEach(function(link){
            link.addEventListener('click', onClickBtnLike);
        })
    </script>
{% endblock %}