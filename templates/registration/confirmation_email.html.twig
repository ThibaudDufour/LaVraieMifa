{% extends "base_email.html.twig" %}
{% block emailBody %}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td><p>Bonjour {{firstname}} {{name|upper}} 😇,</p></td>
        </tr>
        <tr>
            <td>
                <p>L'équipe La Vraie Mifa te souhaite la bienvenue ! 🥳
                Mais il reste une dernière étape pour valider ton inscription 😉</p>
                <p>Clique sur le bouton ci-dessus pour confirmer ton mail</p>
            </td>
        </tr>
        <tr>
            <td style="text-align:center; background-color: #3498db; border-color: #3498db; border: solid 1px #3498db; border-radius: 5px; padding: 12px 25px; ">
                <a style="cursor: pointer; font-size: 14px; font-weight: bold; margin: auto; text-decoration: none; color: #ffffff;" 
                    href="{{ signedUrl }}">Confirmer mon e-mail</a>
            </td>
        </tr>
        <tr>&nbsp;</tr>
        <tr>
            <td>
                <p>Merci, l'équipe La Vraie Mifa.</p>
            </td>
        </tr>
    </table>

{% endblock %}
