{% extends "base_email.html.twig" %}
{% block emailBody %}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td style="margin:auto; text-align:center;">&nbsp;</td>
            <td style="margin:auto; text-align:center;">&nbsp;</td>
            <td style="margin:auto; text-align:center;">&nbsp;</td>
        </tr>
        <tr>
            <td colspan="3"><p>Bonjour {{firstname}} {{ name|upper }} 😇,</p></td>
        </tr>
        <tr>
            <td colspan="3"><p>Souhaitez la bienvenue à :</p><td>
        </tr>
        <tr>
            <td colspan="3" style="margin:auto; text-align:center;">
                {% if photoPath != '-' %}
                    <img class="photo-profil rounded" src="https://lavraiemifa.fr{{ photoPath }}" alt="Photo de profil" width="70" title="Une PP vraimeeeeeeeeennnnnnt !"/>
                {% else %} 
                    <img class="photo-profil rounded" src="https://lavraiemifa.fr/images/icon-user.png" alt="Photo de profil" width="70" title="Une PP vraimeeeeeeeeennnnnnt !"/>
                {% endif %}
                <p>{{ nameNewUser }} {{ firstnameNewUser|upper }}</p>
            </td>
        </tr>
        <tr>&nbsp;</tr>
        <tr>
            <td colspan="3">
                <p>Accueillez-le chaleureusement !</p>
                <p>Merci, l'équipe La Vraie Mifa.</p>
            </td>
        </tr>
    </table>

{% endblock %}