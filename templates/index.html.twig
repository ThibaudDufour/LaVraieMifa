{% extends "base.html.twig" %}
{% block title %}Accueil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/homePage.css">
{% endblock %}

{% block body %}
    <h1 style="text-align:center;margin-bottom:20px;">🎉 Bienvenue sur La Vraie Mifa 🎊</h1>
    <p>Découvrez l'univers de notre équipe en parcourant notre site</p>
    <p>Ce site vous propose des outils qui vous permettront de convertir des fichiers, de partager vos documents ou encore de vous amuser. Vous pouvez proposer des idées ou des améliorations en les ajoutant dans notre <a href="{{ path('todolist') }}">To-Do List</a>. </p>
    <p>Notre site n'est pas géré par des professionnels, mais par des étudiants qui veulent enrichir leurs connaissances</p>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card border-primary scale-up-hor-left">  
                <div class="card-body">
                    <h5 class="card-title">📖 À propos de nous</h5>
                    <div class="card-text">
                        <p>Notre équipe est constituée de six personnes dont vous voyez les photos de profils ci-dessous. Nous nous sommes rencontrés en 2019 grâce au cours à l'IUT.</p>
                        <p>Par la suite, pour enrichir les connaissances acquises durant nos études, nous décidons de créer ce ssite Web qui à connu une première version. Nous gérons tout le serveur web.</p> 
                        <p>Pour en savoir plus sur notre histoire, <a href="{{ path('app_about_us') }}">cliquez ici</a></p>
                    </div>
                    <ul class="galerie_photo">
                        {% for user in users %}
                            {% for role in user.roles %}
                                {% if role == 'ROLE_EQUIPE' %}
                                    <li class="photo-profil-homePage">
                                        <div>
                                            <span class="d-inline-block" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-placement="bottom" data-bs-content="{{ user.firstname }} {{ user.name }}">
                                                <img src="{{ user.profilPhotoPath }}" class="card-img-top img">
                                            </span>
                                        </div>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-success scale-up-hor-center">
                <div class="card-body">
                    <h5 class="card-title">🏆 Meilleurs scores</h5>
                    <div class="card-text">
                        <table id="tabloScore" class="table table-striped table-hover align-middle">
                            <tbody>
                                <tr>
                                    <td><img src="/images/SnakeGame.png" width="35px"/></td>
                                    <td>Snake</td>
                                    <td id="scoreSnake"></td>
                                    <td style="display:none;">{{ path('app_snake') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/Tetris.png" width="35px"/></td>
                                    <td>Tetris</td>
                                    <td id="scoreTetris"></td>
                                    <td style="display:none;">{{ path('app_tetris') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/2048.png" width="35px"/></td>
                                    <td>2048</td>
                                    <td id="score2048"></td>
                                    <td style="display:none;">{{ path('app_2048') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/FlappyBird-Game.png" width="35px"/></td>
                                    <td>Flappy Bird</td>
                                    <td id="scoreFlappyBird"></td>
                                    <td style="display:none;">{{ path('app_flappybird') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/pacman.png" width="35px"/></td>
                                    <td>Pac-Man</td>
                                    <td id="scorePacMan"></td>
                                    <td style="display:none;">{{ path('app_pacman') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/spaceinvaders.png" width="35px"/></td>
                                    <td>Space Invaders</td>
                                    <td id="scoreSpaceInvaders"></td>
                                    <td style="display:none;">{{ path('app_space_invaders') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/bubble-shooter.png" width="35px"/></td>
                                    <td>Bubble Shooter</td>
                                    <td id="scoreBubbleShooter"></td>
                                    <td style="display:none;">{{ path('app_bubble_shooter') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/Jurassic-Park-logo.png" width="35px"/></td>
                                    <td>Jurassic Park</td>
                                    <td id="scoreJurassicPark"></td>
                                    <td style="display:none;">{{ path('app_jurassic_park') }}</td>
                                </tr>
                                <tr>
                                    <td><img src="/images/doodlejump/rightPlayer.png" width="35px"/></td>
                                    <td>Doodle Jump</td>
                                    <td id="scoreDoodleJump"></td>
                                    <td style="display:none;">{{ path('app_doodle_jump') }}</td>
                                </tr>
                            </tbody>
                        </table>
                        {% if app.user %}
                            <p style="text-align:center;margin-bottom:0" class="mt-3">Consultez vos scores en <a href="{{ path('profil') }}">cliquant ici</a> 🏆</p>
                        {% else %}
                            <p style="text-align:center;margin-bottom:0" class="mt-3">Connectez-vous pour consulter vos scores 😛</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-warning scale-up-hor-right">
                <div class="card-body">
                    <h5 class="card-title">📆 Les futurs projets</h5>
                    <div class="card-text">
                        <table id="tableProjet" class='table table-striped table-hover align-middle'>
                        <thead class=''>
                            <tr>
                                <th>Les 3 projets récents</th>
                                <th>Auteur</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for task in tasks %}
                                <tr>
                                    <td class="message">{{ task.description|nl2br }}</td>
                                    <td class="auteur">{{ task.user.firstname }} {{ task.user.name }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td>Aucun projet enregistré</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        </table>
                    </div>
                    <p style="text-align:center;margin-bottom:0">Ajoutez de nouveaux projets en <a href="{{ path('todolist') }}">cliquant ici</a> 😇</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        function addRowHandlers() {
            var table = document.getElementById("tabloScore");
            var rows = table.getElementsByTagName("tr");
            for (i = 0; i < rows.length; i++) {
                var currentRow = table.rows[i];
                var createClickHandler = function(row) {
                    return function() {
                        var cell = row.getElementsByTagName("td")[3];
                        var lien = cell.innerHTML;
                        $.redirect(lien);
                    };
                };
                currentRow.onclick = createClickHandler(currentRow);
            }
        }

        $(document).ready(function(){

            addRowHandlers()

            var theme = sessionStorage.getItem('theme');
            if (theme == 'dark') {
                $("#tableProjet").addClass('table-dark');
                $("#tabloScore").addClass('table-dark');
            } else {
                $("#tableProjet").removeClass('table-dark');
                $("#tabloScore").removeClass('table-dark');
            }


            $.ajax({
                url : "{{ path('scoreSnake', {'newScore' : 0}) }}",
                type : 'GET',
                dataType : 'json',
                beforeSend: function(){
                    // Code à jouer avant d'éxécuter la requête
                    $("#scoreSnake").html("<div class='spinner-border spinner-border-sm text-primary' role='status'><span class='visually-hidden'></span></div>");
                }
            })
            .done(function (output) {
                // Code à jouer en cas d'éxécution sans erreur du script du PHP
                $("#scoreSnake").html(output.best_score);
            })
            .fail(function (error) {
                // Code à jouer en cas d'éxécution en erreur du script du PHP ou de ressource introuvable
                $("#scoreSnake").html("...");
