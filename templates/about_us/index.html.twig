{% extends "base.html.twig" %}

{% block title %}A propos de nous{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="/css/about-us.css">
{% endblock %}

{% block body %} 
  <div id="panel-1-light" class="bg-light">
    <div class="container">
      <div class="row h-100 align-items-center py-5">
        <div class="col-lg-6"  data-aos="fade-right">
          <h2 class="display-6 font-weight-light">À propos de nous</h2>
          <p class="font-italic text-muted">Notre groupe s'est formé au fil du temps et accueil de nouvelles personnes de jours en jours !</p>
          <p class="font-italic text-muted">Étonnant pour de jeunes informaticiens 🤓 non ? </p>
          <p class="font-italic text-muted">Même si nous travaillons dans l'informatique, nous essayons de nous sociabiliser un minimum. 😎</p>
        </div>
        <div class="col-lg-5 px-5 mx-auto order-1 order-lg-2" data-aos="fade-left"><img src="/images/group.png" alt="" class="img-fluid"></div>
      </div>
    </div>
  </div>

  <div id="panel-1-white" class="bg-white py-5">
    <div class="container">
      <div class="row align-items-center mb-5">
        <div class="col-lg-6 order-2 order-lg-1 " data-aos="fade-up">
          <h2 class="display-6 font-weight-light">Nos "compétences"</h2>
          <p class="font-italic text-muted mb-4">Notre groupe a été fondé en 2019 dans une école située à Amiens ... 🤨 une grande école appelé "l'IUT d'Amiens" ... 😅</p>
          <p class="font-italic text-muted mb-4">Cette école nous a permis d'acquérir de nouvelles connaissances pour développer ce magnifique site web, ainsi que notre application mobile !</p>
          <p class="font-italic text-muted">Évidemment, notre site n'est pas parfait ! Nous essayons d'améliorer nos compétences et notre style ... surtout le style 😑</p>
        </div>
        <div class="col-lg-5 px-5 mx-auto order-1 order-lg-2" data-aos="fade-up"><img src="/images/work.png" alt="" class="img-fluid mb-4 mb-lg-0"></div>
      </div>
      <div class="row align-items-center">
        <div class="col-lg-5 px-5 mx-auto" data-aos="flip-down"><img src="/images/marie.gif" alt="" class="img-fluid mb-4 mb-lg-0 rounded shadow-sm"></div>
          <div class="col-lg-6" data-aos="flip-up">
            <h2 class="display-6 font-weight-light">Pourquoi cette mascotte ?</h2>
            <p class="font-italic text-muted mb-4">Notre mascotte est le fruit d'une terrible histoire ayant eu lieu au sein de notre groupe 😱. Notre très jeune développeur mobile jouait Marie du célèbre jeu Animal Crossing sur Smash Bros ...</p>
            <p class="font-italic text-muted mb-4">Elle nous terrorisait et nous battait avec son célèbre feu d'artifice 🎆 ou encore ses cotillons 🎉 en criant " C'est la fête !!! "</p>
        </div>
      </div>
    </div>
  </div>

  <div id="panel-2-light" class="bg-light py-5">
    <div class="container">
      <div class="row mb-4">
        <div class="col-lg-5" data-aos="zoom-in">
          <h2 class="display-6 font-weight-light">Notre équipe</h2>
          <p class="font-italic text-muted">Voici la conposition de notre merveilleuse équipe 😇</p>
        </div>
      </div>
      <div class="row text-center justify-content-center">
        {% for user in users %}
          {% for role in user.roles %}
            {% if role == 'ROLE_EQUIPE' %}
              <!-- Team item -->
                <div class="col-xl-3 col-sm-6 mb-5 " data-aos="zoom-in-down">
                  <div class="bg-white rounded shadow-sm py-5 px-4"><img src="{{ user.profilPhotoPath }}" alt="Photo de profil de {{ user.firstname }} {{ user.name }}" width="90px" height="90px" class="img-fluid rounded-circle mb-3 img-thumbnail shadow-sm">
                    <h5 class="mb-0 text-dark">{{ user.firstname }} <span class="text-uppercase">{{ user.name }}</span></h5><span class="small text-muted">{{ user.functionUser }}</span>
                  </div>
                </div>
              <!-- End -->
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  
  <script type="text/javascript">
    $(document).ready(function(){
    
      var theme = sessionStorage.getItem('theme');
      if (theme == 'dark') {
        $("#panel-1-light").removeClass('bg-light');
        $("#panel-1-white").removeClass('bg-white');
        $("#panel-2-light").removeClass('bg-light');

        $("#panel-1-light").addClass('bg-secondary');
        $("#panel-1-white").addClass('bg-dark');
        $("#panel-2-light").addClass('bg-secondary');
      } else {
        $("#panel-1-light").removeClass('bg-secondary');
        $("#panel-1-white").removeClass('bg-dark');
        $("#panel-2-light").removeClass('bg-secondary');

        $("#panel-1-light").addClass('bg-light');
        $("#panel-1-white").addClass('bg-white');
        $("#panel-2-light").addClass('bg-light');
      }
    });
  </script>
{% endblock %}
