<div class="grille">
    <div class="todo-list">
        <h3>To-Do List</h3>
        <div class="table">
            <table id='tableToDo' class='table table-striped table-hover table-bordered align-middle scale-up-hor-left liste'>
                <thead class='table-dark'>
                    <tr>
                        <th> Tâche à réaliser </th>
                        <th> Auteur </th>
                        <th> Date </th>
                        {% if app.user %}
                            <th> Gestion </th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    {% if task.isDone == false %}
                        <tr>
                            <td class="message"> {{ task.description|nl2br }} </td>
                            <td class="auteur"> {{ task.user.firstname }} {{ task.user.name }} </td>
                            <td class="date"> {{ task.date|date('d-m-Y') }} </td>
                            {% if app.user %}
                                <td> 
                                    <button type="button" class="btnDoneTdl logo" data-bs-toggle="modal" data-bs-target="#doneModal{{ task.id }}">
                                        <i class="fas fa-arrow-right"></i>
                                    </button>
                                    <button type="button" class="btnDelTdl logo trash" data-bs-toggle="modal" data-bs-target="#deleteModal{{ task.id }}">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>

                                <!-- Modal -->
                                <div class="modal fade" id="deleteModal{{ task.id }}" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel">Confirmation</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <img src="/images/modal-tibo.png" alt="Img supprimer un élément" width="120px" title="Êtes-vous sûr de vouloir supprimer cet élément ?"/>
                                        <p>Êtes-vous sûr de vouloir supprimer cet élément ?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <button type="button" class="btn btn-danger" onClick="window.location.href = '/todolist/deleteTask/{{ task.id }}';">Confirmer</button>
                                    </div>
                                    </div>
                                </div>
                                </div>

                                <!-- Modal -->
                                <div class="modal fade" id="doneModal{{ task.id }}" tabindex="-1" aria-labelledby="doneModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="doneModalLabel">Confirmation</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Cette tâche a-t-elle bien été réalisée ?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <button type="button" class="btn btn-danger" onClick="window.location.href = '/todolist/isDone/{{ task.id }}';">Confirmer</button>
                                    </div>
                                    </div>
                                </div>
                                </div>
                            {% endif %}
                        </tr>
                    {% endif %}       
                {% else %}
                    <tr>
                        <td colspan='17'> Pas de tâche enregistrée </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="did-list">
        <h3>Did List</h3>
        <div class="table">
            <table id='tableDid' class='table table-striped table-hover table-bordered align-middle scale-up-hor-right liste'>
                <thead class='table-dark'>
                    <tr>
                        <th> Tâche(s) effectuée(s) </th>
                        <th> Auteur </th>
                        <th> Date </th>
                        {% if app.user %}
                            <th> Gestion </th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    {% if task.isDone == true %}
                        <tr class="trDoList">
                            <td class="line">{{ task.description|nl2br }}</td>
                            <td class="auteur"> {{ task.user.firstname }} {{ task.user.name }} </td>
                            <td class="date"> {{ task.date|date('d-m-Y') }} </td>
                            {% if app.user %}
                                <td> 
                                    <button type="button" class="btnDidntDoneTdl logo" data-bs-toggle="modal" data-bs-target="#didntDoneModal{{ task.id }}">
                                        <i class="fas fa-arrow-left"></i>
                                    </button>
                                    <button type="button" class="btnDelTdl logo trash" data-bs-toggle="modal" data-bs-target="#deleteModal{{ task.id }}">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>

                                <!-- Modal -->
                                <div class="modal fade" id="deleteModal{{ task.id }}" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel">Confirmation</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <img src="/images/modal-tibo.png" alt="Img supprimer un élément" width="120px" title="Êtes-vous sûr de vouloir supprimer cet élément ?"/>
                                        <p>Êtes-vous sûr de vouloir supprimer cet élément ?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <button type="button" class="btn btn-danger" onClick="window.location.href = '/todolist/deleteTask/{{ task.id }}';">Confirmer</button>
                                    </div>
                                    </div>
                                </div>
                                </div>

                                <!-- Modal -->
                                <div class="modal fade" id="didntDoneModal{{ task.id }}" tabindex="-1" aria-labelledby="didntDoneModal" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="didntDoneModal">Confirmation</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Réaffecter cette tâche dans la To-Do List ?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <button type="button" class="btn btn-danger" onClick="window.location.href = '/todolist/isDidntDone/{{ task.id }}';">Confirmer</button>
                                    </div>
                                    </div>
                                </div>
                                </div>
                            {% endif %}
                        </tr>
                    {% endif %}       
                {% else %}
                    <tr>
                        <td colspan='17'> Pas de tâche enregistrée </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
