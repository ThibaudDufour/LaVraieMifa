{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/forgetPassword.css">
{% endblock %}

{% block body %}
    {{ form_start(resetForm, {'attr' : {'id' : 'form'}}) }}
        <h1 class="h3 mb-3 titre_login">Réinitialiser votre mot de passe</h1>

        {{ form_row(resetForm.plainPassword) }}

        <button class="button">Réinitialiser votre mot de passe</button>

    {{ form_end(resetForm) }}
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        $(document).ready(function(){
            var theme = sessionStorage.getItem('theme');
            var form = document.getElementById('form');
                if (theme == 'dark') {
                    form.classList.add('border-info');
                } else {
                    form.classList.remove('border-info');
                }
        });
    </script>
{% endblock %}
