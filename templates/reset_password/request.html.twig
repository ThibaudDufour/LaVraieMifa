{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/forgetPassword.css">
{% endblock %}

{% block body %}
    <div class="grandParentContainer">
        <div class="parentContainer">
            {{ form_start(requestForm, {'attr': {'id': 'requestForm'}}) }}
                {% for flashError in app.flashes('reset_password_error') %}
                    <div class="alert alert-danger" role="alert">{{ flashError }}</div>
                {% endfor %}
                <h1 class="h3 mb-3 titre_login">Réinitialiser votre mot de passe</h1>
                <p>Saisissez votre adresse électronique et nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>
                <div>{{ form_row(requestForm.email) }}</div>
                <button class="button">Envoyer un e-mail de réinitialisation</button>
            {{ form_end(requestForm) }}
       </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        $(document).ready(function(){
            var theme = sessionStorage.getItem('theme');
            var form = document.getElementById('requestForm');
                if (theme == 'dark') {
                    form.classList.add('border-info');
                } else {
                    form.classList.remove('border-info');
                }
        });
    </script>
{% endblock %}
