{% extends "base_email.html.twig" %}
{% block emailBody %}
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td><p>Bonjour {{firstname}} {{name|upper}} 😇,</p></td>
        </tr>
        <tr>
            <td><p>Vous avez récemment demandé à réinitialiser le mot de passe de votre compte.
                Cliquez sur le bouton ci-dessous pour procéder à la réinitialisation.</p></td>
        </tr>
        <tr>
            <td style="text-align:center; background-color: #3498db; border-color: #3498db; border: solid 1px #3498db; border-radius: 5px; padding: 12px 25px; ">
                <a style="cursor: pointer; font-size: 14px; font-weight: bold; margin: auto; text-decoration: none; color: #ffffff;" 
                    href="{{ url('app_reset_password', {token: resetToken.token}) }}">Réinitialiser le mot de passe</a>
            </td>
        </tr>
        <tr>&nbsp;</tr>
        <tr>
            <td>
                <p>Si vous n'avez pas fait cette demande, veuillez ignorer ce mail.</p>
                <p>Merci, l'équipe La Vraie Mifa.</p>
            </td>
        </tr>
    </table>

{% endblock %}