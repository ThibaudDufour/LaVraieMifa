{% extends 'base.html.twig' %}

{% block title %}Convertisseur{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/convertisseur.css">
{% endblock %}

{% block body %}
    <div>
        <h1 class="d-flex justify-content-center">Convertisseur de documents en ligne</h1>
    </div>
    {{ form_start(formConvertisseur,  {'attr': {'id': 'form'}}) }}
        <div class="d-flex justify-content-center form-flex">
            <div>
                {{ form_row(formConvertisseur.file)}}
            </div>
            <div>
                {{ form_row(formConvertisseur.typeoffile)}}
            </div>
        </div>
        <div class='taskBtn'>
            <button id='submitTaskBtn' class='button'> Convertir </button>
        </div>
    {{ form_end(formConvertisseur)}}
    <div class="affichage-telephone">
        <div class="grille">
            <p class="phrase">Ce convertisseur est tellement performant qu'il peut convertir les visages</p>
            <div class="photo-tibo">
                <img src="/images/Tibo-Google.png" class="card-img-top img">
            </div>
            <div class="fleche">
                <span class="fas fa-arrow-right arrow-size"></span>
            </div>
            <div class="photo-maxime">
                <img src="/images/Maxime.png" class="card-img-top img photo">
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript">
        $(document).ready(function(){
            $('#form').submit(convertir)

            function convertir(){
                Toastify({
                    text: 'Convertion du fichier en cours ...',
                    duration: 6000,
                    close: true,
                    //gravity: "top", // `top` or `bottom`
                    //position: "center", // `left`, `center` or `right`
                    offset: {
                        x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                        y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                    },
                    backgroundColor: 'orange', // linear-gradient(to right, #00b09b, #96c93d)
                    stopOnFocus: true, // Prevents dismissing of toast on hover
                    onClick: function(){} // Callback after click
                }).showToast();
            }

            {% if app.session.remove('convertFile') %}
                Toastify({
                    text: 'Impossible de convertir le fichier',
                    duration: 3000,
                    close: true,
                    //gravity: "top", // `top` or `bottom`
                    //position: "center", // `left`, `center` or `right`
                    offset: {
                        x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                        y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                    },
                    backgroundColor: 'red', // linear-gradient(to right, #00b09b, #96c93d)
                    stopOnFocus: true, // Prevents dismissing of toast on hover
                    onClick: function(){} // Callback after click
                }).showToast();
                removeLoader()
            {% endif %}

            {% if app.session.remove('missChamps') %}
                Toastify({
                    text: 'Merci de remplir tous les champs !',
                    duration: 3000,
                    close: true,
                    //gravity: "top", // `top` or `bottom`
                    //position: "center", // `left`, `center` or `right`
                    offset: {
                        x: 50, // horizontal axis - can be a number or a string indicating unity. eg: '2em'
                        y: 100 // vertical axis - can be a number or a string indicating unity. eg: '2em'
                    },
                    backgroundColor: 'red', // linear-gradient(to right, #00b09b, #96c93d)
                    stopOnFocus: true, // Prevents dismissing of toast on hover
                    onClick: function(){} // Callback after click
                }).showToast();
                removeLoader()
            {% endif %}
        })

        function removeLoader(){
            $('#parent').removeClass('parent_loader')
            $('#loader').removeClass('loader')
        }

        function addLoader(){
            $('#parent').addClass('parent_loader')
            $('#loader').addClass('loader')
        }
    </script>
{% endblock %}